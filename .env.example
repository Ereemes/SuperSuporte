# Banco de dados (Prisma + better-sqlite3)
DATABASE_URL="file:./prisma/dev.db"

# Autenticacao JWT (OBRIGATORIO — gere um segredo forte em producao)
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Senhas iniciais dos usuarios seed (minimo 8 caracteres cada)
# Defina antes de rodar: npm run db:seed
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_OPERADOR=
SEED_PASSWORD_CONSULTA=

# AWX (execucao tecnica - futuro)
AWX_BASE_URL=
AWX_TOKEN=

# TopDesk (governanca - futuro)
TOPDESK_BASE_URL=
TOPDESK_API_USER=
TOPDESK_API_KEY=
